VITE_APP_NAME=MasterFlota
VITE_APP_LOGO_MONOGRAM=MF
VITE_MARKETING_URL=https://masterflota.com
VITE_COMPANY_NAME=EQAAB
VITE_COMPANY_URL=https://eqaab.com
