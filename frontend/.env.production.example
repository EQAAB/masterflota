# Copy to .env.production on your production build server:
#   cp .env.production.example .env.production
#
# Vite loads this automatically for `npm run build`.
# Do not commit .env.production (it is gitignored).
#
# Use the Nginx API path (not :4100) when the API is proxied.
# HTTP until TLS is configured (Certbot / load balancer).
#
# Optional: VITE_BASE_PATH=/fleet (default) for /fleet/ on one host.
# For subdomain deploy see .env.production.masterflota.example (VITE_BASE_PATH=/).
#
# Optional white-label branding (see README.md#white-label--branding):
#   VITE_APP_NAME=Fleet Manager
#   VITE_APP_LOGO_MONOGRAM=FM
#   VITE_MARKETING_URL=
#   VITE_COMPANY_NAME=
#   VITE_COMPANY_URL=

VITE_API_URL=http://169.58.28.189/fleet-api
