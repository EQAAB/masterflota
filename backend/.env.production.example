PORT=4100

# PostgreSQL (local on same VM)
DATABASE_URL=postgres://fleetadmin:348CoP3I2iy0@localhost:5432/fleetmanager

# Generate: openssl rand -base64 48
JWT_SECRET=aK9sL2vM5xQ8pN3rT7wY1fG4cU9bZ0dJ6sA5eP2

APP_VERSION=1.0.0

# Comma-separated allowed browser origins (scheme + host + optional port/path prefix)
