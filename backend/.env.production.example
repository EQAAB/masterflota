# Production backend environment
# Copy on the server:
#   cp .env.production.example .env
#   nano .env

NODE_ENV=production
PORT=4100

# PostgreSQL (local on same VM)
DATABASE_URL=postgres://fleetadmin:348CoP3I2iy0@localhost:5432/fleetmanager

# Generate: openssl rand -base64 48
JWT_SECRET=aK9sL2vM5xQ8pN3rT7wY1fG4cU9bZ0dJ6sA5eP2

APP_VERSION=1.0.0

# Shown in generated rental contracts ("Generated by ___.") and error/log context.
# APP_NAME=Fleet Manager

# Comma-separated allowed browser origins (scheme + host + optional port/path prefix)
# Example VM: http://169.58.28.189
CORS_ORIGINS=http://169.58.28.189

# Login rate limit (optional — defaults: 10 attempts per 15 minutes)
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Optional: first super admin (used by npm run bootstrap:super-admin)
BOOTSTRAP_SUPER_ADMIN_EMAIL='admin@example.com' \
BOOTSTRAP_SUPER_ADMIN_PASSWORD='SAdmin@!765' \
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME='Fleet' \
BOOTSTRAP_SUPER_ADMIN_LAST_NAME='Admin' \
# npm run bootstrap:super-admin

# ANAF e-Factura (invoicing module)
ANAF_CLIENT_ID=9db1d1d5652181bdfa97f363b4de8af16c1f1513cbaa856a
ANAF_CLIENT_SECRET=c99b29e6fc1c92443d889ce434303d8d7f61500e43a58af16c1f1513cbaa856a
