# Production backend environment — Masterflota
# Copy on the server:
#   cp .env.production.masterflota.example .env
#   nano .env

NODE_ENV=production
PORT=4100

# PostgreSQL (local on same VM)
DATABASE_URL=postgres://fleetadmin:CHANGE_ME@localhost:5432/fleetmanager

# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

APP_VERSION=1.0.0

# Shown in generated rental contracts ("Generated by ___.")
APP_NAME=MasterFlota

# app.masterflota.com serves the frontend that calls this API
CORS_ORIGINS=https://app.masterflota.com

# Login rate limit (optional — defaults: 10 attempts per 15 minutes)
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Optional: first super admin (used by npm run bootstrap:super-admin)
BOOTSTRAP_SUPER_ADMIN_EMAIL='admin@masterflota.com' \
BOOTSTRAP_SUPER_ADMIN_PASSWORD='CHANGE_ME' \
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME='MasterFlota' \
BOOTSTRAP_SUPER_ADMIN_LAST_NAME='Admin' \
# npm run bootstrap:super-admin
